<launch>
  <!-- ORB-SLAM pipeline node -->
  <node pkg="orb_slam_node" type="orb_slam_node.py" name="orb_slam_node" output="screen">
    <!-- Input topics — adjust to match your camera driver -->
    <param name="image_topic"       value="/duckiebot21/camera_node/image/compressed"/>
    <param name="camera_info_topic" value="/duckiebot21/camera_node/camera_info"/>

    <!-- ORB feature count per frame (higher = denser map, slower) -->
    <param name="n_features"     type="int"    value="5000"/>

    <!-- Cap on accumulated 3-D map points -->
    <param name="max_map_points" type="int"    value="10000"/>

    <!--
      Fallback camera intrinsics used when camera_info is unavailable.
      Format: [fx, 0, cx,  0, fy, cy,  0, 0, 1]
      The values below match the notebook calibration; replace with your own.
    -->
    <rosparam param="camera_matrix">[3177.0, 0.0, 1632.0, 0.0, 3177.0, 1224.0, 0.0, 0.0, 1.0]</rosparam>
  </node>

</launch>
